# Copy this file to .env (which git ignores) and fill in your own values.
# Never commit real keys.

# "mock" = pre-written AI lines, no keys needed. "live" = real AI calls.
AI_PROVIDER=mock

# Free keys, no credit card needed:
#   Groq:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Models tried in order ("provider:model"). Run scripts/try_models.py --list to see
# what your keys can use, and scripts/try_models.py to compare them.
ANALYZER_MODELS=groq:llama-3.1-8b-instant,gemini:gemini-2.5-flash-lite
CHARACTER_MODELS=groq:llama-3.3-70b-versatile,gemini:gemini-2.5-flash
